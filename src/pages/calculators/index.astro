<BaseLayout
  title="Calculators"
  description="Engineering calculators — gear ratio, beam deflection, bolt torque, and more — coming soon to Creek Mechanical."
>
  <section class="coming-soon wrap">
    <span class="badge">Coming soon</span>
    <h1>Calculators</h1>
    <p>
      Closed-form engineering calculators are coming here first: gear
