---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculators } from '../../lib/calculators/registry';
---

<BaseLayout
  title="Calculators"
  description="Free engineering calculators — gear ratio, beam deflection, bolt torque, bearing life, pipe flow, buckling, and more."
>
  <section class="hero wrap">
    <h1>Engineering Calculators</h1>
    <p>
      Closed-form calculators with metric/imperial unit switching, a
      shareable permalink for every result, and a visible worked formula so
      you can check the math yourself.
    </p>
  </section>

  <section class="wrap">
    <div class="hub-grid">
      {calculators.map((c) => (
        <a class="hub-card" href={`/calculators/${c.slug}/`}>
          <h3>{c.title}</h3>
          <p>{c.shortDescription}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
