<BaseLayout
  title="Reference"
  description="Material properties, fastener sizes, thread specs, and other engineering reference tables — coming soon to Creek Mechanical."
>
  <section class="coming-soon wrap">
    <span class="badge">Coming soon</span>
    <h1>Reference</h1>
