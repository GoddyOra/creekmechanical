---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { referenceTables } from '../../lib/reference/tables';
---

<BaseLayout
  title="Reference"
  description="Free engineering reference tables — tap drill sizes, bolt torque specs, thread specifications, material properties, hardness conversion, surface finish, and gauge sizes."
>
  <section class="hero wrap">
    <h1>Engineering Reference Tables</h1>
    <p>
      Sortable, filterable lookup tables. Copy any table for pasting into a
      spreadsheet, or print/save it as a PDF.
    </p>
  </section>

  <section class="wrap">
    <div class="hub-grid">
      {referenceTables.map((t) => (
        <a class="hub-card" href={`/reference/${t.slug}/`}>
          <h3>{t.title}</h3>
          <p>{t.shortDescription}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
