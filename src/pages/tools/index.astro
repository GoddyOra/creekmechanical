---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tools"
  description="Browser-based CAD viewers, converters, and geometry utilities — coming soon to Creek Mechanical."
>
  <section class="coming-soon wrap">
    <span class="badge">Coming soon</span>
    <h1>Tools</h1>
    <p>
      This section will hold browser-based CAD tools: a STEP/IGES viewer
      with STL/OBJ/3MF export, and a CAD compatibility checker that reports
      what will break when a file is opened downstream. Every tool will run
      entirely client-side — nothing you open here is ever uploaded.
    </p>
  </section>
</BaseLayout>
