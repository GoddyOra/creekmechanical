---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { viewerTools } from '../../lib/viewer/registry';
---

<BaseLayout
  title="Tools"
  description="Browser-based CAD tools — view and convert STEP, IGES, and BREP files to STL, OBJ, and 3MF. Nothing is uploaded."
>
  <section class="hero wrap">
    <h1>Tools</h1>
    <p>
      Browser-based CAD viewers and converters. Every tool runs entirely
      client-side — your files never leave your computer.
    </p>
  </section>

  <section class="wrap">
    <div class="hub-grid">
      <a class="hub-card" href="/tools/cad-compatibility-checker/">
        <h3>CAD Compatibility Checker</h3>
        <p>Upload a STEP, IGES, or BREP file and get a health report: unit consistency, open shells, non-manifold edges, and assembly structure.</p>
      </a>
      {viewerTools.map((t) => (
        <a class="hub-card" href={`/tools/${t.slug}/`}>
          <h3>{t.title}</h3>
          <p>{t.shortDescription}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
