<div class="checker viewer" data-checker>
  <div class="viewer-badge">🔒 Processed entirely in your browser — nothing is uploaded</div>

  <div class="viewer-upload">
    <label class="viewer-file-btn">
      Choose file
      <input type="file" data-file-input accept=".step,.stp,.iges,.igs,.brep" />
    </label>
    <span class="viewer-filename" data-filename>No file selected</span>
  </div>

  <p class="viewer-error" data-error hidden></p>
  <p class="viewer-loading" data-loading hidden>Analyzing file…</p>

  <div class="checker-report" data-report hidden>
    <p class="checker-summary" data-summary></p>
    <ul class="checker-findings" data-findings></ul>
    <div class="checker-actions">
      <button type="button" class="ref-btn" data-copy-report>Copy report</button>
      <button type="button" class="ref-btn" data-download-report>Download report</button>
      <a class="ref-btn" href="/tools/step-iges-viewer/">Open in 3D viewer</a>
    </div>
  </div>
</div>

<script>
  import { detectFormat } from '../lib/viewer/format';
  import { buildHealthReport, formatReportAsText, type HealthReport } from '../lib/checker/report';
  import type { CadFormat } from '../lib/viewer/occt-types';
  import type { ParseRequest, ParseResponse } from '../lib/viewer/parse-worker';

  const root = document.querySelector<HTMLElement>('[data-checker]')!;
  const fileInput = root.querySelector<HTMLInputElement>('[data-file-input]')!;
  const filenameEl = root.querySelector<HTMLElement>('[data-filename]')!;
  const errorEl = root.querySelector<HTMLElement>('[data-error]')!;
  const loadingEl = root.querySelector<HTMLElement>('[data-loading]')!;
  const reportEl = root.querySelector<HTMLElement>('[data-report]')!;
  const summaryEl = root.querySelector<HTMLElement>('[data-summary]')!;
  const findingsEl = root.querySelector<HTMLUListElement>('[data-findings]')!;
  const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy-report]')!;
  const downloadBtn = root.querySelector<HTMLButtonElement>('[data-download-report]')!;

  let worker: Worker | null = null;
  let currentReport: HealthReport | null = null;

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearError() {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function renderReport(report: HealthReport) {
    currentReport = report;
    reportEl.hidden = false;
    summaryEl.textContent = `${report.format.toUpperCase()} file — ${report.assembly.partCount} solid${report.assembly.partCount === 1 ? '' : 's'}, ${report.totals.triangleCount.toLocaleString()} triangles.`;

    findingsEl.innerHTML = '';
    for (const finding of report.findings) {
      const li = document.createElement('li');
      li.className = `finding finding--${finding.severity}`;
      const text = document.createElement('span');
      text.textContent = finding.text;
      li.appendChild(text);
      if (finding.cta) {
        const cta = document.createElement('a');
        cta.href = '/services/';
        cta.className = 'finding-cta';
        cta.textContent = 'We can fix this for you →';
        li.appendChild(cta);
      }
      findingsEl.appendChild(li);
    }
  }

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;

    const format: CadFormat | null = detectFormat(file.name);
    clearError();
    reportEl.hidden = true;
    if (!format) {
      showError('Unsupported file type. Please choose a .step, .stp, .iges, .igs, or .brep file.');
      return;
    }

    filenameEl.textContent = file.name;
    loadingEl.hidden = false;

    const buffer = await file.arrayBuffer();
    // Decode before transferring — TextDecoder only reads the buffer, so
    // this is safe to do right before postMessage neuters it below.
    const fileText = new TextDecoder('latin1').decode(buffer);

    if (!worker) {
      worker = new Worker(new URL('../lib/viewer/parse-worker.ts', import.meta.url), { type: 'module' });
    }

    worker.onmessage = (event: MessageEvent<ParseResponse>) => {
      loadingEl.hidden = true;
      if (event.data.type === 'error') {
        showError(event.data.message);
        return;
      }
      const report = buildHealthReport(
        file.name,
        format,
        { success: true, meshes: event.data.meshes, root: event.data.root },
        fileText
      );
      renderReport(report);
    };
    worker.onerror = () => {
      loadingEl.hidden = true;
      showError('The parser crashed on this file. It may be too large or malformed.');
    };

    const request: ParseRequest = { fileName: file.name, buffer, format };
    worker.postMessage(request, [buffer]);
  });

  copyBtn.addEventListener('click', async () => {
    if (!currentReport) return;
    try {
      await navigator.clipboard.writeText(formatReportAsText(currentReport));
    } catch {
      // Clipboard API unavailable in this browser context.
    }
    const original = copyBtn.textContent;
    copyBtn.textContent = 'Copied!';
    setTimeout(() => {
      copyBtn.textContent = original;
    }, 1500);
  });

  downloadBtn.addEventListener('click', () => {
    if (!currentReport) return;
    const text = formatReportAsText(currentReport);
    const blob = new Blob([text], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${currentReport.fileName.replace(/\.[^./]+$/, '')}-health-report.txt`;
    link.click();
    URL.revokeObjectURL(url);
  });
</script>
